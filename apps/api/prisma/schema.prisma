generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  PENDING
  EXTRACTING
  ANALYZING
  COMPLETED
  FAILED
}

enum Role {
  CANDIDATE
  RECRUITER
  EMPLOYER
}

enum ApplicationStatus {
  SUBMITTED
  DISCARDED
  FORWARDED
  ADJUSTMENT_REQUESTED
  ACCEPTED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role
  analyses     Analysis[]
  jobs         Job[]         @relation("EmployerJobs")
  applications Application[] @relation("CandidateApplications")
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Analysis {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileSizeBytes Int
  status        AnalysisStatus
  extractedText String?
  resultJson    Json?
  errorMessage  String?
  modelUsed     String?
  application   Application?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, createdAt])
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  lookingFor   String
  employerId   String
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([employerId, createdAt])
  @@index([createdAt])
}

enum RecruiterNoteAction {
  NOTE
  FORWARD
  DISCARD
}

model Application {
  id               String                @id @default(cuid())
  jobId            String
  job              Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User                  @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  analysisId       String                @unique
  analysis         Analysis              @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  status           ApplicationStatus     @default(SUBMITTED)
  recruiterNote    String?
  decisionMessage  String?
  submissionCount  Int                   @default(1)
  /** JSON array of RecruiterTag strings; recruiter-only. */
  recruiterTags    Json                  @default("[]")
  noteEntries      RecruiterNoteEntry[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
  @@index([status, createdAt])
}

model RecruiterNoteEntry {
  id            String              @id @default(cuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  text          String
  action        RecruiterNoteAction
  createdAt     DateTime            @default(now())

  @@index([applicationId, createdAt])
}
